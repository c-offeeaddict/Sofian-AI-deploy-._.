rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // DEFAULT DENY
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // GLOBAL HELPERS
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isDocOwner() {
      return isSignedIn() && (resource == null || !('userId' in resource.data) || request.auth.uid == resource.data.userId || resource.data.userId == null);
    }

    function isPublicSession() {
      return resource != null && 'isPublic' in resource.data && resource.data.isPublic == true;
    }
    
    function isDocOwnerOrPublicSession() {
      return isDocOwner() || (isSignedIn() && exists(/databases/$(database)/documents/sessions/$(resource.data.sessionId)) && get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data.isPublic == true);
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidEmail(email) {
      return email is string && email.size() >= 3 && email.matches('^.+@.+\\..+$');
    }

    function isAdmin() {
      return isSignedIn() && 
        (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
          (request.auth.token.email == "sofian20118@gmail.com" && request.auth.token.email_verified == true)
        );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ===============================================================
    // VALIDATION HELPERS
    // ===============================================================
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
             data.uid == request.auth.uid &&
             isValidId(data.uid) &&
             (data.email == 'unknown@example.com' || isValidEmail(data.email)) &&
             (data.createdAt is timestamp || data.createdAt is number) &&
             (!('role' in data) || data.role == 'user'); // Non-admins can't set their own role to admin
    }

    function isValidSession(data) {
      return data.keys().hasAll(['id', 'title', 'userId', 'modes', 'timestamp']) &&
             isValidId(data.id) &&
             (data.userId == request.auth.uid || data.userId == existing().userId) &&
             data.title is string && data.title.size() <= 200 &&
             data.modes is list &&
             (data.timestamp is number || data.timestamp is timestamp) &&
             (!('isPublic' in data) || data.isPublic is bool);
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'sessionId', 'role', 'content', 'timestamp', 'userId']) &&
             isValidId(data.id) &&
             isValidId(data.sessionId) &&
             data.userId == request.auth.uid &&
             data.role in ['user', 'assistant'] &&
             data.content is string && data.content.size() <= 1048576 && // 1MB
             (data.timestamp is number || data.timestamp is timestamp);
    }

    function isValidMindMode(data) {
      return data.keys().hasAll(['id', 'label', 'icon', 'systemInstruction', 'userId']) &&
             isValidId(data.id) &&
             data.userId == request.auth.uid &&
             data.label is string && data.label.size() <= 100 &&
             data.icon is string && data.icon.size() <= 20 &&
             data.systemInstruction is string && data.systemInstruction.size() <= 100000;
    }

    function isValidMemory(data) {
      return data.keys().hasAll(['id', 'fact', 'userId']) &&
             isValidId(data.id) &&
             data.userId == request.auth.uid &&
             data.fact is string && data.fact.size() <= 10000;
    }

    // ===============================================================
    // COLLECTION RULES
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && (
        // Allow updating settings, displayName, photoURL
        (incoming().diff(existing()).affectedKeys().hasOnly(['settings', 'displayName', 'photoURL', 'updatedAt'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if isDocOwner() || isAdmin() || isPublicSession();
      allow create: if isSignedIn() && isValidSession(incoming());
      allow update: if (isDocOwner() || isAdmin() || isPublicSession()) && 
                    isValidSession(incoming()) && 
                    (!('userId' in existing()) || incoming().userId == existing().userId) &&
                    (incoming().diff(existing()).affectedKeys().hasOnly(['id', 'title', 'modes', 'timestamp', 'updatedAt', 'isFavorite', 'createdAt', 'userId', 'isPublic'])) &&
                    (existing().createdAt == incoming().createdAt || !('createdAt' in existing()));
      allow delete: if isDocOwner() || isAdmin();
    }

    match /messages/{messageId} {
      allow read: if isDocOwner() || isAdmin() || isDocOwnerOrPublicSession();
      allow create: if isSignedIn() && isValidMessage(incoming());
      allow update: if (isDocOwner() || isAdmin() || isDocOwnerOrPublicSession()) && 
                    isValidMessage(incoming()) && 
                    (!('userId' in existing()) || incoming().userId == existing().userId) &&
                    (!('sessionId' in existing()) || incoming().sessionId == existing().sessionId);
      allow delete: if isDocOwner() || isAdmin();
    }

    match /mindModes/{modeId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isSignedIn() && isValidMindMode(incoming());
      allow update: if (isDocOwner() || isAdmin()) && 
                    isValidMindMode(incoming()) && 
                    incoming().userId == existing().userId;
      allow delete: if isDocOwner() || isAdmin();
    }

    match /memories/{memoryId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isSignedIn() && isValidMemory(incoming());
      allow update: if (isDocOwner() || isAdmin()) && 
                    isValidMemory(incoming()) && 
                    incoming().userId == existing().userId;
      allow delete: if isDocOwner() || isAdmin();
    }

    // Test connection doc
    match /test/connection {
      allow read: if isSignedIn();
    }
  }
}
