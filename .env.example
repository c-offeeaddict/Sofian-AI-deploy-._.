# To use this application outside of Google AI Studio, create a copy of this file
# named ".env" and paste your Gemini API key below.

VITE_GEMINI_API_KEY=

# Google Maps Platform Key for local search feature (Landmarks, Mosques, Cafes, etc.)
GOOGLE_MAPS_PLATFORM_KEY=

# CALL-E API Configuration
CALL_E_API_KEY=
